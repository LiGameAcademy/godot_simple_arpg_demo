; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="3d_simple_rpg"
run/main_scene="uid://30orglekea3b"
config/features=PackedStringArray("4.5", "Mobile")
config/icon="res://icon.svg"

[autoload]

GameplayAbilitySystem="*res://addons/godot_gameplay_abilities/scripts/singletons/gameplay_ability_system.gd"
DamageCalculator="*res://addons/godot_gameplay_abilities/scripts/singletons/damage_calculator.gd"
AbilityEventBus="*res://addons/godot_gameplay_abilities/scripts/singletons/ability_event_bus.gd"
CombatUtils="*res://addons/godot_gameplay_abilities/scripts/utils/combat_utils.gd"
AttachmentPointUtils="*res://addons/godot_gameplay_abilities/scripts/utils/attachment_point_utils.gd"
TagManager="*res://addons/godot_gameplay_abilities/scripts/singletons/gameplay_tag_manager.gd"
GameplayCueManager="*res://addons/godot_gameplay_abilities/scripts/singletons/gameplay_cue_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=960
window/size/window_height_override=540
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_gameplay_abilities/plugin.cfg", "res://addons/simple_inventory/plugin.cfg")

[global_group]

Entities=""

