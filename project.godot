;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="3d_simple_rpg"
run/main_scene="uid://30orglekea3b"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[autoload]

DialogueManager="*res://addons/laoli_dialogue_system/scripts/core/dialogue/dialogue_manager.gd"
GameState="*res://scripts/globals/game_state.gd"
QuestManager="*res://scripts/globals/quest_manager.gd"

[display]

