; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="3d_simple_rpg"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[autoload]

GameplayAbilitySystem="*res://addons/godot_gameplay_abilities/scripts/singletons/gameplay_ability_system.gd"
AbilityEventBus="*res://addons/godot_gameplay_abilities/scripts/singletons/ability_event_bus.gd"
TagManager="*res://addons/godot_gameplay_abilities/scripts/singletons/gameplay_tag_manager.gd"
GameplayCueManager="*res://addons/godot_gameplay_abilities/scripts/singletons/gameplay_cue_manager.gd"
ItemManager="*res://addons/simple_inventory/scripts/managers/item_manager.gd"
ItemUseStrategyManager="*res://addons/simple_inventory/scripts/managers/item_use_strategy_manager.gd"
TalentManager="*res://scripts/singletons/talent_manager.gd"
Panku="*res://addons/panku_console/console.tscn"
DDD="*res://addons/zylann.debug_draw/debug_draw.gd"
GameState="*res://scripts/globals/game_state.gd"
DialogueHistoryManager="*res://addons/laoli_dialogue_system/scripts/core/history/dialogue_history_manager.gd"
VariableManager="*res://addons/laoli_dialogue_system/scripts/core/variable/variable_manager.gd"
QuestManager="*res://addons/laoli_dialogue_system/scripts/core/quest/quest_manager.gd"
DialogueManager="*res://addons/laoli_dialogue_system/scripts/core/dialogue/dialogue_manager.gd"

[debug_draw_3d]

settings/addon_root_folder="res://addons/debug_draw_3d"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=960
window/size/window_height_override=540
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/laoli_dialogue_system/plugin.cfg", "res://addons/simple_inventory/plugin.cfg")

[global_group]

Entities=""

